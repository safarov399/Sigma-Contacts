<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/dropdown_tint"
    >

    <TextView
        android:id="@+id/help_feedback_share_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/details_popup_tv_padding_vert"
        android:paddingStart="@dimen/details_popup_tv_padding_start"
        android:text="Share"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="@dimen/details_popup_font"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/help_feedback_line_1"
        android:layout_width="0dp"
        android:layout_height="@dimen/details_popup_line_height"
        android:background="@drawable/horizontal_line_background"
        android:paddingVertical="@dimen/details_popup_line_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_share_tv" />

    <TextView
        android:id="@+id/help_feedback_calling_sim_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/details_popup_tv_padding_vert"
        android:paddingStart="@dimen/details_popup_tv_padding_start"
        android:text="Set calling SIM"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="@dimen/details_popup_font"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_line_1" />

    <TextView
        android:id="@+id/help_feedback_ringtone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/details_popup_tv_padding_vert"
        android:paddingStart="@dimen/details_popup_tv_padding_start"
        android:text="Set ringtone"
        android:textSize="@dimen/details_popup_font"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_calling_sim_tv" />

    <TextView
        android:id="@+id/help_feedback_home_screen_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/details_popup_tv_padding_vert"
        android:paddingStart="@dimen/details_popup_tv_padding_start"
        android:text="Add to home screen"
        android:textSize="@dimen/details_popup_font"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_ringtone" />

    <View
        android:id="@+id/help_feedback_line_2"
        android:layout_width="0dp"
        android:layout_height="@dimen/details_popup_line_height"
        android:background="@drawable/horizontal_line_background"
        android:paddingVertical="@dimen/details_popup_line_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_home_screen_tv" />

    <TextView
        android:id="@+id/help_feedback_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/details_popup_tv_padding_vert"
        android:paddingStart="@dimen/details_popup_tv_padding_start"
        android:paddingEnd="8dp"
        android:text="Move to another account"
        android:textSize="@dimen/details_popup_font"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_line_2" />

    <TextView
        android:id="@+id/help_feedback_delete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/details_popup_tv_padding_vert"
        android:paddingStart="@dimen/details_popup_tv_padding_start"
        android:text="Delete"
        android:textSize="@dimen/details_popup_font"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_account" />

    <View
        android:id="@+id/help_feedback_line_3"
        android:layout_width="0dp"
        android:layout_height="@dimen/details_popup_line_height"
        android:background="@drawable/horizontal_line_background"
        android:paddingVertical="@dimen/details_popup_line_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_delete" />

    <TextView
        android:id="@+id/help_feedback_help"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/details_popup_tv_padding_vert"
        android:paddingStart="@dimen/details_popup_tv_padding_start"
        android:text="Help &amp; feedbck"
        android:textSize="@dimen/details_popup_font"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_feedback_line_3" />

</androidx.constraintlayout.widget.ConstraintLayout>